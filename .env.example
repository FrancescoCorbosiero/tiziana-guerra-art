# Copiare in ".env" (non va su git) e compilare. Usato dal servizio "contatti" in docker-compose.yml.

# Destinatario dei messaggi del modulo
MAIL_TO=forevertizzy@gmail.com
# Mittente: deve essere un indirizzo o dominio VERIFICATO su Amazon SES.
# Non usare un indirizzo @yahoo.it come mittente: Yahoo lo rifiuterebbe (DMARC).
MAIL_FROM="Tiziana Guerra Art <sito@tizianaguerra.art>"

# --- Opzione A (consigliata): API di SES con chiavi IAM ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Opzione B: credenziali SMTP di SES (quelle usate dal plugin WP SMTP) ---
# Se SMTP_HOST è compilato, si usa SMTP e le chiavi AWS sopra vengono ignorate.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Prova senza inviare nulla (il messaggio viene scritto nei log del container)
# DRY_RUN=1
