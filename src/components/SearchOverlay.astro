---
import OverlayClose from './OverlayClose.astro';
import { site } from '~/config/site';
---

<div id="search" popover class="overlay search-overlay" role="dialog" aria-label="Cerca tra le opere">
  <div class="overlay__bar">
    <a class="overlay__logo" href="/">{site.logo}</a>
    <OverlayClose target="search" />
  </div>

  <div class="search-overlay__body container">
    <form class="search-form" role="search" action="/pitture/" data-search-form>
      <label class="label search-form__label" for="search-input">Cerca tra le opere</label>
      <input
        id="search-input"
        class="search-form__input"
        type="search"
        name="q"
        placeholder="Titolo, tema, tecnica, anno…"
        autocomplete="off"
        spellcheck="false"
        autofocus
        data-search-input
      />
    </form>
    <p class="search-overlay__status serif-italic" role="status" aria-live="polite" data-search-status></p>
    <ul class="search-results" role="list" data-search-results></ul>
    <noscript><p class="search-overlay__status">La ricerca richiede JavaScript: sfoglia le opere nella pagina Pitture.</p></noscript>
  </div>
</div>

<style>
  .search-overlay__body {
    padding-block: clamp(24px, 8vh, 96px) 64px;
  }

  .search-form {
    display: grid;
    gap: 18px;
  }

  .search-form__label {
    color: var(--c-muted);
  }

  .search-form__input {
    width: 100%;
    padding: 0.15em 0 0.25em;
    border: 0;
    border-bottom: 2px solid var(--c-ink);
    border-radius: 0;
    background: transparent;
    color: var(--c-ink);
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    font-size: clamp(1.6rem, 0.9rem + 3.4vw, 4.5rem);
    line-height: 1.15;
    text-transform: uppercase;
    -webkit-appearance: none;
    appearance: none;
  }

  .search-form__input::placeholder {
    color: rgb(33 29 19 / 0.28);
    text-transform: none;
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    font-stretch: 100%;
  }

  .search-form__input:focus {
    outline: none;
    border-bottom-color: var(--c-accent);
  }

  .search-form__input::-webkit-search-cancel-button {
    display: none;
  }

  .search-overlay__status {
    min-height: 1.7em;
    margin: 20px 0 8px;
    font-size: 1.25rem;
    color: var(--c-muted);
  }

  .search-results {
    display: grid;
  }

  .search-results :global(a) {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    gap: 6px 18px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(33 29 19 / 0.12);
  }

  .search-results :global(img) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    background: var(--c-mat);
  }

  .search-results :global(.num) {
    display: none;
  }

  @media (min-width: 768px) {
    .search-results :global(a) {
      grid-template-columns: 80px 3.2em 1fr;
      gap: 6px 24px;
    }

    .search-results :global(img) {
      width: 80px;
      height: 80px;
    }

    .search-results :global(.num) {
      display: block;
      font-size: 1.35rem;
    }
  }

  .search-results :global(.search-results__title) {
    display: block;
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    font-size: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--c-ink);
  }

  .search-results :global(.search-results__meta) {
    display: block;
    margin-top: 6px;
    line-height: 1.3;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--c-muted);
    text-transform: none;
    font-stretch: 100%;
    font-weight: 400;
  }

  .search-results :global(a:hover .search-results__title),
  .search-results :global(a:focus-visible .search-results__title) {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.18em;
  }
</style>

<script>
  type Voce = { t: string; u: string; i: string; n: string; m: string; s: string };

  const overlay = document.getElementById('search');
  const form = overlay?.querySelector<HTMLFormElement>('[data-search-form]');
  const input = overlay?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = overlay?.querySelector<HTMLUListElement>('[data-search-results]');
  const status = overlay?.querySelector<HTMLElement>('[data-search-status]');

  if (overlay && form && input && results && status) {
    let indice: Voce[] | undefined;
    let caricamento: Promise<Voce[]> | undefined;

    const normalizza = (s: string) =>
      s
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '')
        .toLowerCase();

    const carica = () =>
      (caricamento ??= fetch('/cerca.json')
        .then((r) => r.json() as Promise<Voce[]>)
        .then((dati) => (indice = dati)));

    const mostra = () => {
      if (!indice) return;
      const q = normalizza(input.value.trim());
      if (!q) {
        results.replaceChildren();
        status.textContent = '';
        return;
      }
      const termini = q.split(/\s+/);
      const trovate = indice.filter((v) => termini.every((t) => v.s.includes(t)));
      status.textContent = trovate.length
        ? `${trovate.length} ${trovate.length === 1 ? 'opera trovata' : 'opere trovate'}`
        : 'Nessuna opera trovata';
      results.replaceChildren(
        ...trovate.slice(0, 30).map((v, i) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = v.u;
          const img = document.createElement('img');
          img.src = v.i;
          img.alt = '';
          img.width = 72;
          img.height = 72;
          img.loading = 'lazy';
          const num = document.createElement('span');
          num.className = 'num';
          num.textContent = `/${String(i + 1).padStart(2, '0')}`;
          const testo = document.createElement('span');
          const titolo = document.createElement('span');
          titolo.className = 'search-results__title';
          titolo.textContent = v.t;
          const meta = document.createElement('span');
          meta.className = 'search-results__meta';
          meta.textContent = [v.n, v.m].filter(Boolean).join(' · ');
          testo.append(titolo, meta);
          a.append(img, num, testo);
          li.append(a);
          return li;
        }),
      );
    };

    overlay.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState === 'open') {
        input.focus();
        carica().then(mostra);
      }
    });
    input.addEventListener('input', () => (indice ? mostra() : carica().then(mostra)));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const primo = results.querySelector('a');
      if (primo) window.location.href = primo.href;
    });
  }
</script>
