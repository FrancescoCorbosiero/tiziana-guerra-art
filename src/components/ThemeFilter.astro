---
import { urlTema, type TemaConOpere } from '~/lib/opere';

interface Props {
  temi: TemaConOpere[];
  totale: number;
  /** id del tema attivo; assente = "Tutte". */
  attivo?: string;
}

const { temi, totale, attivo } = Astro.props;
const voci = [
  { href: '/pitture/', label: 'Tutte', count: totale, current: !attivo },
  ...temi.map(({ tema, opere }) => ({
    href: urlTema(tema.id),
    label: tema.data.titolo,
    count: opere.length,
    current: attivo === tema.id,
  })),
];
---

{
  temi.length > 1 && (
    <nav class="theme-filter reveal" style="--delay:.24s" aria-label="Filtra per tema">
      <ul role="list">
        {voci.map((v) => (
          <li>
            <a href={v.href} aria-current={v.current ? 'page' : undefined}>
              <span class="brush">{v.label}</span>
              <sup class="num">{v.count}</sup>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .theme-filter {
    margin-top: clamp(32px, 4vw, 64px);
  }

  .theme-filter ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(22px, 3vw, 44px);
  }

  .theme-filter a {
    display: inline-flex;
    align-items: flex-start;
    gap: 4px;
    padding-block: 6px;
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.09375rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-text);
  }

  .theme-filter a[aria-current='page'] .brush::after {
    clip-path: inset(0 0 0 0);
  }

  .theme-filter .num {
    font-size: 0.95em;
    top: -0.35em;
    position: relative;
    vertical-align: baseline;
    line-height: 0;
  }
</style>
