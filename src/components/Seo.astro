---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '~/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, image, imageAlt, type = 'website', jsonLd, noindex = false } =
  Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Immagine per la condivisione social: JPEG 1200px generato in fase di build.
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;

const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
  og && ogUrl && (
    <>
      <meta property="og:image" content={ogUrl} />
      <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
      <meta property="og:image:height" content={String(og.attributes.height ?? '')} />
      <meta property="og:image:alt" content={imageAlt ?? title ?? site.name} />
    </>
  )
}
<meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />

{ld.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
