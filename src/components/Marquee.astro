---
interface Props {
  frasi: string[];
}
const { frasi } = Astro.props;
---

{/* Frasi che scorrono (text marquee del tema). Il testo duplicato è nascosto agli screen reader. */}
<section class="marquee" aria-label="In breve">
  {
    frasi.map((frase, i) => (
      <div class:list={['marquee__row', { 'marquee__row--reverse': i % 2 === 1 }]}>
        <p class="marquee__track">
          <span>{frase}</span>
          <span aria-hidden="true">{frase}</span>
        </p>
      </div>
    ))
  }
</section>

<style>
  .marquee {
    overflow: hidden;
  }

  .marquee__row {
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    font-family: var(--f-serif);
    font-weight: 300;
    font-size: clamp(3rem, 1.4rem + 5.4vw, 7.5rem); /* 120px */
    line-height: 0.91;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-text);
  }

  .marquee__track span {
    padding-right: 0.5em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee 48s linear infinite;
    }

    .marquee__row--reverse .marquee__track {
      animation-direction: reverse;
      animation-duration: 56s;
    }

    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }

    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }
</style>
