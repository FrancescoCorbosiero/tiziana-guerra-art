---
import Parole from './Parole.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!-- Fascia del titolo del tema: crema, alta 240px, titolo a sinistra nella griglia da 1300px -->
<header class="page-title">
  <div class="container page-title__inner">
    <h1 class="h1 page-title__text intro-words"><Parole testo={title} /></h1>
    <slot />
  </div>
</header>

<style>
  .page-title {
    background: var(--c-cream);
  }

  .page-title__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(150px, 16vw, 240px);
    padding-block: 32px;
  }

  .page-title__text {
    margin: 0;
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
