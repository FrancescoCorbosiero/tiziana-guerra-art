---
import { Picture } from 'astro:assets';
import { altOpera, urlOpera, vtName, type Opera } from '~/lib/opere';

interface Props {
  opere: Opera[];
  label?: string;
}

const { opere, label = 'Opere in evidenza' } = Astro.props;
const totale = String(opere.length).padStart(2, '0');
---

{/* Carosello del tema: riquadri quadrati affiancati, scorrimento orizzontale con aggancio. */}
<section class="carousel" aria-label={label} data-carousel>
  <ul role="list" class="carousel__track" data-track tabindex="0">
    {
      opere.map((opera) => (
        <li class="carousel__slide">
          <a href={urlOpera(opera)} style={`--vt:${vtName(opera)}`}>
            <div class="carousel__media cover zoom">
              <Picture
                src={opera.data.immagine}
                alt={altOpera(opera)}
                widths={[400, 600, 900, 1200]}
                sizes="(min-width: 1025px) 591px, 80vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="carousel__title">{opera.data.titolo}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="carousel__controls">
    <button class="carousel__btn" type="button" data-prev aria-label="Opera precedente">←</button>
    <p class="num carousel__counter" aria-live="polite">
      <span data-current>01</span> / {totale}
    </p>
    <button class="carousel__btn" type="button" data-next aria-label="Opera successiva">→</button>
  </div>
</section>

<style>
  .carousel {
    /* la prima opera parte dal bordo del contenitore, le altre escono a destra fino al bordo dello schermo */
    --pad: max(var(--gutter), (100% - var(--container)) / 2);
    --slide: min(591px, 78vw);
  }

  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    padding-inline: var(--pad);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track:focus-visible {
    outline-offset: -2px;
  }

  .carousel__slide {
    flex: none;
    width: var(--slide);
    scroll-snap-align: start;
  }

  .carousel__slide a {
    position: relative;
    display: block;
  }

  .carousel__media {
    aspect-ratio: 1;
  }

  .carousel__slide a:is(:hover, :focus-visible) :global(img) {
    view-transition-name: var(--vt);
  }

  /* Titolo che compare al passaggio del mouse ("info on hover" del tema) */
  .carousel__title {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h5);
    line-height: 1.05;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.45);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--t-med) var(--ease-out),
      transform var(--t-med) var(--ease-out);
  }

  .carousel__slide a:is(:hover, :focus-visible) .carousel__title {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .carousel__title {
      opacity: 1;
      transform: none;
    }
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    padding: 22px var(--pad) 0;
  }

  .carousel__counter {
    margin: 0;
    font-weight: 300;
    color: var(--c-text);
  }

  .carousel__btn {
    width: 44px;
    height: 44px;
    font-family: var(--f-serif);
    font-size: 1.5rem;
    color: var(--c-text);
    transition: transform var(--t-fast) ease-out;
  }

  .carousel__btn:hover {
    transform: scale(1.15);
  }

  .carousel__btn:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;

    const indice = () => {
      const base = track.getBoundingClientRect().left + parseFloat(getComputedStyle(track).paddingLeft);
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.getBoundingClientRect().left - base);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    const aggiorna = () => {
      const i = indice();
      current.textContent = String(i + 1).padStart(2, '0');
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    const vai = (delta: number) => {
      const target = slides[Math.min(slides.length - 1, Math.max(0, indice() + delta))];
      if (target) track.scrollTo({ left: target.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft), behavior: 'smooth' });
    };
    prev.addEventListener('click', () => vai(-1));
    next.addEventListener('click', () => vai(1));
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(aggiorna);
      },
      { passive: true },
    );
    aggiorna();
  }
</script>
