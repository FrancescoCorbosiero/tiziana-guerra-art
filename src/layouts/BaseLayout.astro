---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import '~/styles/global.css';
import ContactBand from '~/components/ContactBand.astro';
import MenuOverlay from '~/components/MenuOverlay.astro';
import SearchOverlay from '~/components/SearchOverlay.astro';
import Seo from '~/components/Seo.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import ToTop from '~/components/ToTop.astro';
import { site } from '~/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Fascia "Scrivimi" prima del footer. */
  contactBand?: boolean;
}

const { contactBand = true, ...seo } = Astro.props;

// Navigazione istantanea: il browser prepara la pagina successiva al passaggio del mouse
// (Speculation Rules, ignorate dai browser che non le supportano).
const speculationRules = JSON.stringify({
  prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
});
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-cormorant" />
    <Seo {...seo} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="speculationrules" set:html={speculationRules} />
  </head>
  <body>
    <div id="top"></div>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <SiteHeader />
    <main id="contenuto">
      <slot />
    </main>
    {contactBand && <ContactBand />}
    <SiteFooter />
    <ToTop />
    <MenuOverlay />
    <SearchOverlay />
    <slot name="overlays" />
    <script>
      import '~/scripts/overlays.ts';
    </script>
  </body>
</html>
