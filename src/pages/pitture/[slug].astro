---
import type { GetStaticPaths } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import MasonryGrid from '~/components/MasonryGrid.astro';
import OverlayClose from '~/components/OverlayClose.astro';
import { site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import {
  altOpera,
  etichettaDisponibilita,
  getOpere,
  mailtoOpera,
  parseDimensioni,
  urlCategoria,
  urlOpera,
  vtName,
  whatsappOpera,
  type Opera,
} from '~/lib/opere';

export const getStaticPaths = (async () => {
  const opere = await getOpere();
  return opere.map((opera, index) => {
    const categorie = new Set(opera.data.categorie.map((c) => c.id));
    const stessaCategoria = opere.filter((o) => o.id !== opera.id && o.data.categorie.some((c) => categorie.has(c.id)));
    // opere correlate: le successive nell'ordine della galleria, ricominciando dall'inizio
    const correlate = [...stessaCategoria.filter((o) => opere.indexOf(o) > index), ...stessaCategoria].filter(
      (o, i, arr) => arr.indexOf(o) === i,
    );
    return {
      params: { slug: opera.id },
      props: {
        opera,
        precedente: opere[index - 1],
        successiva: opere[index + 1],
        correlate: correlate.slice(0, 3),
      },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  opera: Opera;
  precedente?: Opera;
  successiva?: Opera;
  correlate: Opera[];
}

const { opera, precedente, successiva, correlate } = Astro.props;
const { data } = opera;
const categorie = await getEntries(data.categorie);
const { Content } = await render(opera);

const pageUrl = new URL(urlOpera(opera), Astro.site).href;
const disponibile = data.disponibilita === 'disponibile';
const mostraPrezzo = Boolean(site.mostraPrezzi && data.prezzo && disponibile);
const whatsapp = whatsappOpera(opera, pageUrl);
// "Richiedi informazioni" / "Acquista" portano al modulo con l'oggetto già compilato;
// se il modulo non è attivo, aprono l'email precompilata.
const linkRichiesta = (motivo: 'info' | 'acquisto') =>
  site.contactFormEndpoint
    ? `/contatti/?${new URLSearchParams({
        oggetto: `${motivo === 'acquisto' ? 'Acquisto opera' : "Informazioni sull'opera"}: ${data.titolo}`,
      })}#modulo`
    : mailtoOpera(opera, motivo, pageUrl);
const haTesto = Boolean(opera.body?.trim());

type Dettaglio = { label: string; value: string; links?: { label: string; href: string }[] };
const dettagli = [
  data.dimensioni ? { label: 'Dimensioni', value: data.dimensioni } : undefined,
  data.anno ? { label: 'Anno', value: String(data.anno) } : undefined,
  data.tecnica ? { label: 'Tecnica', value: data.tecnica } : undefined,
  categorie.length
    ? {
        label: categorie.length > 1 ? 'Categorie' : 'Categoria',
        value: categorie.map((c) => c.data.titolo).join(', '),
        links: categorie.map((c) => ({ label: c.data.titolo, href: urlCategoria(c.id) })),
      }
    : undefined,
  data.disponibilita ? { label: 'Disponibilità', value: etichettaDisponibilita[data.disponibilita] } : undefined,
  mostraPrezzo ? { label: 'Prezzo', value: data.prezzo! } : undefined,
].filter((d): d is Dettaglio => Boolean(d));

// Dati strutturati (schema.org) per i motori di ricerca.
const ogImage = await getImage({ src: data.immagine, width: 1200, format: 'jpg' });
const dimensioni = parseDimensioni(data.dimensioni);
const testoSemplice = opera.body
  ?.replace(/\\\n/g, ' ')
  .replace(/[*_>#`\\]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const descrizioneBreve = testoSemplice ? testoSemplice.slice(0, 155) : undefined;
const description =
  descrizioneBreve ??
  [`${data.titolo}${data.anno ? ` (${data.anno})` : ''}`, data.tecnica ?? categorie.map((c) => c.data.titolo).join(', '), data.dimensioni]
    .filter(Boolean)
    .join(' · ') + ` — opera di ${site.author}.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: data.titolo,
    url: pageUrl,
    image: new URL(ogImage.src, Astro.site).href,
    artform: 'Pittura',
    artMedium: data.tecnica ?? categorie.map((c) => c.data.titolo).join(', '),
    ...(data.anno && { dateCreated: String(data.anno) }),
    ...(dimensioni && {
      width: { '@type': 'Distance', name: dimensioni.larghezza },
      height: { '@type': 'Distance', name: dimensioni.altezza },
    }),
    ...(descrizioneBreve && { description: descrizioneBreve }),
    creator: { '@type': 'Person', '@id': `${site.url}/#artista`, name: site.author, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Pitture', item: new URL('/pitture/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: data.titolo, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={data.titolo}
  description={description}
  image={data.immagine}
  imageAlt={altOpera(opera)}
  type="article"
  jsonLd={jsonLd}
>
  <article class="artwork container">
    <button class="artwork__stage" type="button" popovertarget="zoom-0" aria-label="Ingrandisci l'immagine">
      <Picture
        src={data.immagine}
        alt={altOpera(opera)}
        widths={[640, 960, 1300, 1800, 2400]}
        sizes="(min-width: 1400px) 1300px, calc(100vw - 40px)"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        priority
        style={`view-transition-name:${vtName(opera)}`}
      />
      <span class="artwork__zoom-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16"
          ><path d="M10 4H4v6M14 4h6v6M10 20H4v-6M14 20h6v-6" fill="none" stroke="currentColor" stroke-width="1.6"
          ></path></svg
        >
        Ingrandisci
      </span>
    </button>

    {
      data.dettagli.length > 0 && (
        <ul role="list" class="artwork__details">
          {data.dettagli.map((d, i) => (
            <li>
              <button class="artwork__detail" type="button" popovertarget={`zoom-${i + 1}`} aria-label="Ingrandisci il dettaglio">
                <Picture
                  src={d.immagine}
                  alt={d.alt ?? `${data.titolo}, dettaglio ${i + 1}`}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 769px) 33vw, 50vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
      )
    }

    <div class="artwork__grid">
      <div class="artwork__main">
        <h1 class="h1 artwork__title">{data.titolo}</h1>
        {
          haTesto && (
            <div class="prose text artwork__text">
              <Content />
            </div>
          )
        }
        <div class="artwork__actions">
          {
            disponibile && (
              <a class="btn" href={linkRichiesta('acquisto')}>
                Acquista
              </a>
            )
          }
          <a class:list={['btn', { 'btn--ghost': disponibile }]} href={linkRichiesta('info')}>
            Richiedi informazioni
          </a>
        </div>
        {
          site.contatti.email && (
            <p class="artwork__contact">
              Oppure scrivi a <a href={mailtoOpera(opera, 'info', pageUrl)}>{site.contatti.email}</a>
              {whatsapp && (
                <>
                  {' · '}
                  <a href={whatsapp} rel="noopener" target="_blank">
                    WhatsApp
                  </a>
                </>
              )}
            </p>
          )
        }
      </div>

      {
        dettagli.length > 0 && (
          <dl class="artwork__info">
            {dettagli.map((d) => (
              <div>
                <dt class="h6">{d.label}:</dt>
                <dd>
                  {d.links
                    ? d.links.map((l, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={l.href}>{l.label}</a>
                        </>
                      ))
                    : d.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <nav class="artwork__pager" aria-label="Opere precedente e successiva">
      {
        precedente ? (
          <a
            class="btn-text"
            href={urlOpera(precedente)}
            aria-label={`Opera precedente: ${precedente.data.titolo}`}
            aria-keyshortcuts="ArrowLeft"
            data-pager="precedente"
          >
            <span class="brush brush--on">Precedente</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        successiva && (
          <a
            class="btn-text"
            href={urlOpera(successiva)}
            aria-label={`Opera successiva: ${successiva.data.titolo}`}
            aria-keyshortcuts="ArrowRight"
            data-pager="successiva"
          >
            <span class="brush brush--on">Successivo</span>
          </a>
        )
      }
    </nav>
  </article>

  {
    correlate.length > 0 && (
      <section class="related container" aria-label="Altre opere">
        <MasonryGrid opere={correlate} colonne={3} gutter="normal" eager={0} label="Altre opere" headingLevel="h2" />
      </section>
    )
  }

  <!-- Visualizzazione a tutto schermo (Popover API: funziona anche senza JavaScript) -->
  <Fragment slot="overlays">
    {
      [{ immagine: data.immagine, alt: altOpera(opera) }, ...data.dettagli].map((img, i) => (
        <div id={`zoom-${i}`} popover class="overlay zoom-overlay" role="dialog" aria-label={`${data.titolo}: immagine ingrandita`}>
          <div class="overlay__bar zoom-overlay__bar">
            <span class="h6 zoom-overlay__title">{data.titolo}</span>
            <OverlayClose target={`zoom-${i}`} />
          </div>
          <Picture
            class="zoom-overlay__img"
            src={img.immagine}
            alt={img.alt ?? data.titolo}
            widths={[1200, 1800, 2600]}
            sizes="100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </Fragment>
</BaseLayout>

<script>
  // Frecce ← → della tastiera: opera precedente / successiva, come sfogliare un catalogo.
  // Non interferiscono con i campi di testo, le scorciatoie del browser e gli overlay aperti.
  const versi: Partial<Record<string, string>> = { ArrowLeft: 'precedente', ArrowRight: 'successiva' };
  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    const verso = versi[event.key];
    if (!verso || event.isComposing) return;
    const origine = event.target instanceof Element ? event.target : null;
    if (origine?.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
    if (document.querySelector('.overlay:popover-open')) return;
    const link = document.querySelector<HTMLAnchorElement>(`[data-pager="${verso}"]`);
    if (link) {
      event.preventDefault();
      link.click();
    }
  });
</script>

<style>
  .artwork {
    padding-top: clamp(32px, 5vw, 80px);
  }

  .artwork__stage {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    cursor: zoom-in;
  }

  .artwork__stage :global(picture) {
    display: contents;
  }

  /* come nel tema: foto allineata a sinistra con il titolo, alle sue dimensioni naturali */
  .artwork__stage :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 82svh;
  }

  .artwork__zoom-hint {
    position: absolute;
    right: 16px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: rgb(255 255 255 / 0.9);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text);
    opacity: 0;
    transition: opacity var(--t-fast) ease-out;
  }

  .artwork__stage:hover .artwork__zoom-hint,
  .artwork__stage:focus-visible .artwork__zoom-hint {
    opacity: 1;
  }

  .artwork__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .artwork__detail {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }

  .artwork__detail :global(img) {
    width: 100%;
    height: auto;
  }

  .artwork__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    margin-top: clamp(32px, 3vw, 44px);
  }

  .artwork__title {
    margin-bottom: 12px;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .artwork__text :global(p) {
    margin: 10px 0;
  }

  .artwork__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(24px, 2.6vw, 40px);
  }

  .artwork__contact {
    margin: 14px 0 0;
    font-size: 1rem;
    color: var(--c-muted);
  }

  .artwork__contact a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .artwork__info {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .artwork__info div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  .artwork__info dt {
    flex: none;
  }

  .artwork__info dd a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .artwork__pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(56px, 6vw, 90px);
  }

  .related {
    margin-top: clamp(72px, 8vw, 130px);
  }

  @media (min-width: 1025px) {
    .artwork__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 60px;
    }

    .artwork__info {
      padding-top: 6px;
    }
  }

  /* Zoom a tutto schermo */
  .zoom-overlay:popover-open {
    display: flex;
    flex-direction: column;
  }

  .zoom-overlay__bar {
    justify-content: space-between;
  }

  .zoom-overlay__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .zoom-overlay :global(picture) {
    display: contents;
  }

  .zoom-overlay :global(.zoom-overlay__img) {
    flex: 1;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0 var(--gutter) var(--gutter);
  }
</style>
