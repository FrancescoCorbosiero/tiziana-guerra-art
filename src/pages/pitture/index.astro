---
import MasonryGrid from '~/components/MasonryGrid.astro';
import PageHeader from '~/components/PageHeader.astro';
import ThemeFilter from '~/components/ThemeFilter.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getOpere, getTemiConOpere } from '~/lib/opere';

const [opere, temi] = await Promise.all([getOpere(), getTemiConOpere()]);
const conteggio = `${opere.length} ${opere.length === 1 ? 'opera originale' : 'opere originali'}`;
---

<BaseLayout
  title="Pitture"
  description={`Le pitture di Tiziana Guerra: ${conteggio}, suddivise per tema. Clicca un'opera per la scheda completa.`}
  image={opere[0]?.data.immagine}
>
  <PageHeader eyebrow="Opere" title="Pitture" lead={conteggio}>
    <ThemeFilter temi={temi} totale={opere.length} />
  </PageHeader>

  <section class="container" aria-label="Elenco delle pitture">
    <MasonryGrid opere={opere} />
  </section>
</BaseLayout>
