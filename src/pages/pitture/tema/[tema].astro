---
import type { GetStaticPaths } from 'astro';
import MasonryGrid from '~/components/MasonryGrid.astro';
import PageHeader from '~/components/PageHeader.astro';
import ThemeFilter from '~/components/ThemeFilter.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getOpere, getTemiConOpere, type TemaConOpere } from '~/lib/opere';

export const getStaticPaths = (async () => {
  const temi = await getTemiConOpere();
  return temi.map((voce) => ({ params: { tema: voce.tema.id }, props: { voce } }));
}) satisfies GetStaticPaths;

interface Props {
  voce: TemaConOpere;
}

const { voce } = Astro.props;
const { tema, opere } = voce;
const [tutte, temi] = await Promise.all([getOpere(), getTemiConOpere()]);
---

<BaseLayout
  title={`${tema.data.titolo} — Pitture`}
  description={tema.data.descrizione ?? `Pitture di Tiziana Guerra: ${tema.data.titolo.toLowerCase()}.`}
  image={opere[0]?.data.immagine}
>
  <PageHeader eyebrow="Pitture" title={tema.data.titolo} lead={tema.data.descrizione}>
    <ThemeFilter temi={temi} totale={tutte.length} attivo={tema.id} />
  </PageHeader>

  <section class="container" aria-label={`Pitture: ${tema.data.titolo}`}>
    <MasonryGrid opere={opere} label={tema.data.titolo} />
  </section>
</BaseLayout>
