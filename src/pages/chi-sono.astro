---
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { inlineMarkdown } from '~/lib/inline-md';
import { site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { altOpera, getOpera, urlOpera } from '~/lib/opere';

const pagina = await getEntry('pagine', 'chi-sono');
if (!pagina) throw new Error('Manca src/content/pagine/chi-sono.md');

const { Content } = await render(pagina);
const { titolo, descrizioneSeo, intro, biografia, evidenza, eventi } = pagina.data;
const operaEvidenza = evidenza?.opera ? await getOpera(evidenza.opera.id) : undefined;
---

<BaseLayout
  title="Chi sono"
  description={descrizioneSeo ?? `Biografia e percorso artistico di ${site.author}.`}
  image={intro?.immagine}
  imageAlt={intro?.immagineAlt}
  type="article"
  header="minimal"
>
  <section class="cs-hero container-wide">
    <h1 class="h1 cs-hero__title reveal">{titolo}</h1>
  </section>

  {
    intro && (
      <section class="cs-intro container" aria-labelledby="cs-intro-title">
        <div class="cs-intro__text">
          {intro.sopratitolo && <p class="tagline">{intro.sopratitolo}</p>}
          <h2 class="h2" id="cs-intro-title">
            {intro.titolo}
          </h2>
          {intro.testo && <p class="text cs-intro__p">{intro.testo}</p>}
          {intro.testo2 && <p class="text cs-intro__p cs-intro__p--soft">{intro.testo2}</p>}
        </div>
        {intro.immagine && (
          <figure class="cs-intro__figure cover appear-zoom">
            <Picture
              src={intro.immagine}
              alt={intro.immagineAlt}
              widths={[400, 625, 940, 1250]}
              sizes="(min-width: 1025px) 625px, calc(100vw - 40px)"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              priority
            />
          </figure>
        )}
      </section>
    )
  }

  <section class="cs-bio container" aria-labelledby="cs-bio-title">
    {
      biografia && (
        <header class="cs-center">
          {biografia.sopratitolo && <p class="tagline cs-upper">{biografia.sopratitolo}</p>}
          <h2 class="h2" id="cs-bio-title">
            {biografia.titolo}
          </h2>
        </header>
      )
    }
    <div class="prose text cs-bio__text">
      <Content />
    </div>
  </section>

  {
    evidenza && (
      <section class="cs-highlight container" aria-label="In evidenza">
        <p class="text cs-highlight__text">{evidenza.testo}</p>
        {operaEvidenza && (
          <a class="cs-highlight__image appear-zoom" href={urlOpera(operaEvidenza)}>
            <Picture
              src={operaEvidenza.data.immagine}
              alt={altOpera(operaEvidenza)}
              widths={[480, 760, 1000, 1400]}
              sizes="(min-width: 1100px) 1000px, calc(100vw - 40px)"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              decoding="async"
            />
          </a>
        )}
      </section>
    )
  }

  {
    eventi && (
      <section class="cs-events container" aria-labelledby="cs-events-title">
        <header class="cs-center">
          {eventi.sopratitolo && <p class="tagline">{eventi.sopratitolo}</p>}
          <h2 class="h2" id="cs-events-title">
            {eventi.titolo}
          </h2>
        </header>
        <div class="cs-events__list">
          {eventi.anni.map((a) => (
            <div class="cs-events__year">
              <h3 class="cs-events__anno">{a.anno}</h3>
              <ul role="list">
                {a.voci.map((v) => (
                  <li set:html={inlineMarkdown(v)} />
                ))}
              </ul>
            </div>
          ))}
        </div>
        {eventi.immagine && (
          <figure class="cs-events__image">
            <Picture
              src={eventi.immagine}
              alt={eventi.immagineAlt}
              widths={[400, 570, 860, 1080]}
              sizes="(min-width: 640px) 570px, calc(100vw - 40px)"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}
      </section>
    )
  }
</BaseLayout>

<style>
  .cs-hero {
    padding-top: clamp(16px, 2vw, 30px);
  }

  .cs-hero__title {
    max-width: 26ch;
    font-size: clamp(2.25rem, 1.2rem + 3.2vw, 4.375rem); /* 70px */
  }

  .cs-intro {
    display: grid;
    gap: 40px;
    align-items: start;
    margin-top: clamp(56px, 7vw, 140px);
  }

  .cs-intro__text {
    max-width: 460px;
  }

  .cs-intro__text .h2 {
    margin-top: 11px;
  }

  .cs-intro__p {
    margin: 30px 0 0;
  }

  .cs-intro__p--soft {
    color: var(--c-muted);
  }

  .cs-intro__figure {
    margin: 0;
    aspect-ratio: 625 / 650;
  }

  @media (min-width: 1025px) {
    .cs-intro {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding-inline: 10px;
    }

    .cs-intro__figure {
      justify-self: end;
      width: min(100%, 625px);
    }
  }

  .cs-center {
    text-align: center;
  }

  .cs-center .h2 {
    margin-top: 11px;
  }

  .cs-upper {
    text-transform: uppercase;
  }

  .cs-bio {
    margin-top: clamp(80px, 9vw, 150px);
  }

  .cs-bio__text {
    max-width: 1140px;
    margin: 32px auto 0;
  }

  .cs-bio__text :global(p) {
    margin: 0 0 10px;
  }

  .cs-highlight {
    margin-top: clamp(48px, 5vw, 70px);
    text-align: center;
  }

  .cs-highlight__text {
    max-width: 1100px;
    margin: 0 auto;
  }

  .cs-highlight__image {
    display: block;
    width: min(100%, 1000px);
    margin: 20px auto 0;
  }

  .cs-highlight__image :global(img) {
    width: 100%;
  }

  .cs-events {
    margin-top: clamp(80px, 9vw, 150px);
  }

  .cs-events__list {
    display: grid;
    gap: 26px;
    max-width: 1140px;
    margin: 32px auto 0;
    text-align: center;
  }

  .cs-events__anno {
    margin: 0 0 4px;
    font-family: var(--f-body);
    font-weight: 500;
    font-size: inherit;
    color: var(--c-text);
  }

  .cs-events__list li {
    color: var(--c-body);
  }

  .cs-events__list li :global(em) {
    font-style: italic;
  }

  .cs-events__image {
    width: min(100%, 570px);
    margin: 40px auto 0;
  }

  .cs-events__image :global(img) {
    width: 100%;
  }
</style>
