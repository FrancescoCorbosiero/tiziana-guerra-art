---
import { Picture } from 'astro:assets';
import PageTitle from '~/components/PageTitle.astro';
import { site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import torreGuida from '~/assets/pagine/la-torre-guida.webp';

const { email, telefono, whatsapp, luogo } = site.contatti;
type Recapito = { label: string; value: string; href?: string; external?: boolean };
const candidati: (Recapito | undefined)[] = [
  email ? { label: 'Email', value: email, href: `mailto:${email}` } : undefined,
  telefono ? { label: 'Telefono', value: telefono, href: `tel:${telefono.replace(/[^\d+]/g, '')}` } : undefined,
  whatsapp ? { label: 'WhatsApp', value: 'Scrivimi su WhatsApp', href: `https://wa.me/${whatsapp}`, external: true } : undefined,
  ...site.social.map((s) => ({ label: s.label, value: '@' + s.url.replace(/\/$/, '').split('/').pop(), href: s.url, external: true })),
  luogo ? { label: 'Dove', value: luogo } : undefined,
];
const recapiti = candidati.filter((r): r is Recapito => Boolean(r));
---

<BaseLayout title="Contatti" description={`Per informazioni e richieste sulle opere di ${site.author}, inviami un messaggio.`}>
  <PageTitle title="Contatti" />

  <section class="contacts container">
    <div class="contacts__main">
      <h2 class="h3 contacts__title">Per informazioni e richieste, inviami un messaggio</h2>

      <dl class="contacts__list">
        {
          recapiti.map((r) => (
            <div>
              <dt class="h6">{r.label}</dt>
              <dd>
                {r.href ? (
                  <a class="contacts__value" href={r.href} {...(r.external ? { rel: 'noopener', target: '_blank' } : {})}>
                    <span class="brush-inline">{r.value}</span>
                  </a>
                ) : (
                  <span class="contacts__value">{r.value}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        site.contactFormEndpoint && (
          <form class="contact-form" action={site.contactFormEndpoint} method="POST">
            <label>
              <span class="h6">Nome</span>
              <input name="nome" type="text" autocomplete="name" required />
            </label>
            <label>
              <span class="h6">Email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              <span class="h6">Oggetto</span>
              <input name="oggetto" type="text" />
            </label>
            <label>
              <span class="h6">Messaggio</span>
              <textarea name="messaggio" rows="6" required />
            </label>
            <label class="contact-form__privacy">
              <input type="checkbox" name="privacy" required />
              <span>Acconsento al trattamento dei dati per ricevere una risposta.</span>
            </label>
            <button class="btn" type="submit">
              Invia
            </button>
          </form>
        )
      }
    </div>

    <figure class="contacts__figure">
      <Picture
        src={torreGuida}
        alt="La torre guida — dipinto di Tiziana Guerra"
        widths={[480, 720, 1024]}
        sizes="(min-width: 1025px) 520px, 90vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>
</BaseLayout>

<style>
  .contacts {
    display: grid;
    gap: 56px;
    padding-top: clamp(56px, 6vw, 100px);
  }

  .contacts__title {
    max-width: 30ch;
  }

  .contacts__list {
    display: grid;
    gap: 28px;
    margin-top: clamp(36px, 4vw, 56px);
  }

  .contacts__list dt {
    margin-bottom: 6px;
  }

  .contacts__value {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h4);
    line-height: 1.15;
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  .contacts__figure {
    margin: 0;
  }

  .contacts__figure :global(img) {
    width: 100%;
  }

  .contact-form {
    display: grid;
    gap: 22px;
    margin-top: 56px;
    max-width: 640px;
  }

  .contact-form label {
    display: grid;
    gap: 8px;
  }

  .contact-form input:not([type='checkbox']),
  .contact-form textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--c-text);
    border-radius: 0;
    background: transparent;
    font: inherit;
    color: var(--c-text);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--c-accent);
  }

  .contact-form__privacy {
    grid-template-columns: auto 1fr;
    align-items: start;
    font-size: 1rem;
  }

  .contact-form .btn {
    justify-self: start;
  }

  @media (min-width: 1025px) {
    .contacts {
      grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
      gap: 80px;
      align-items: start;
    }
  }
</style>
