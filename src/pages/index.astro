---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import Carousel from '~/components/Carousel.astro';
import Marquee from '~/components/Marquee.astro';
import { site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { altOpera, getOpera, getOpereInEvidenza, urlOpera } from '~/lib/opere';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Manca src/content/home/home.md');
const { titolo, descrizioneSeo, hero, intro, frasi, chiSono } = home.data;

// Le due opere dell'hero: un'immagine libera oppure un'opera della collezione (con link alla scheda)
const heroItems = await Promise.all(
  hero.map(async (h) => {
    const opera = h.opera ? await getOpera(h.opera.id) : undefined;
    const immagine: ImageMetadata | undefined = h.immagine ?? opera?.data.immagine;
    return {
      titolo: h.titolo,
      immagine,
      href: opera ? urlOpera(opera) : undefined,
      alt: opera ? altOpera(opera) : `${h.titolo} — dipinto di ${site.author}`,
    };
  }),
);
const carosello = await getOpereInEvidenza(8);
const paragrafi = (t: string) => t.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'it-IT' },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#artista`, // stessa entità della pagina Chi sono (ProfilePage)
    name: site.author,
    alternateName: site.pseudonimo,
    url: site.url,
    jobTitle: 'Artista',
    sameAs: site.social.map((s) => s.url),
  },
];
---

<BaseLayout
  title="Tiziana Guerra Artista Pittrice"
  description={descrizioneSeo}
  image={heroItems[1]?.immagine ?? heroItems[0]?.immagine}
  jsonLd={jsonLd}
  header="switch"
>
  <!-- HERO: "Vita e rinascita" + due opere con didascalia verticale -->
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__title reveal">{titolo}</h1>

    <div class="hero__works grid-12">
      {
        heroItems.map((item, i) => {
          const Tag = item.href ? 'a' : 'div';
          return (
            <figure class:list={['hero__work', `hero__work--${i === 0 ? 'small' : 'big'}`]}>
              <figcaption class="h6 hero__label">{item.titolo}</figcaption>
              <Tag class="hero__media cover appear-zoom" href={item.href}>
                {item.immagine && (
                  <Picture
                    src={item.immagine}
                    alt={item.alt}
                    widths={i === 0 ? [360, 560, 750] : [600, 820, 1000, 1640]}
                    sizes={
                      i === 0
                        ? '(min-width: 1440px) 375px, (min-width: 769px) 25vw, calc(100vw - 40px)'
                        : '(min-width: 1440px) 820px, (min-width: 769px) 57vw, calc(100vw - 40px)'
                    }
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    priority={i === 1}
                    loading={i === 1 ? undefined : 'eager'}
                  />
                )}
              </Tag>
            </figure>
          );
        })
      }
    </div>
  </section>

  <!-- /01 Introduzione -->
  <section class="intro grid-12 container" aria-labelledby="intro-title">
    <div class="intro__text">
      <p class="num">/01</p>
      <h2 id="intro-title" class="h1 intro__title">{intro.titolo}</h2>
      <p class="text intro__p">{intro.testo}</p>
      <a class="btn-text intro__link" href={intro.link.href}>
        <span class="brush brush--on">{intro.link.testo}</span>
      </a>
    </div>
    {
      intro.immagine && (
        <figure class="intro__figure" style={`--w:${intro.immagine.width}px`}>
          <Picture
            src={intro.immagine}
            alt={intro.immagineAlt}
            widths={[intro.immagine.width, intro.immagine.width * 2]}
            sizes={`(min-width: 769px) ${intro.immagine.width}px, calc(100vw - 40px)`}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
  </section>

  <!-- Carosello delle opere in evidenza -->
  {carosello.length > 0 && <Carousel opere={carosello} />}

  <!-- Frasi che scorrono -->
  {frasi.length > 0 && <Marquee frasi={frasi} />}

  <!-- Chi sono / La mia arte, poi Partecipazioni & eventi -->
  <section class="about container" aria-label="Chi sono">
    <div class="about__grid grid-12">
      <div class="about__images">
        {
          chiSono.immagini.map((img, i) => (
            <figure
              class:list={['about__image cover appear-zoom', `about__image--${i}`]}
              style={img.posizione ? `--pos:${img.posizione}` : undefined}
            >
              <Picture
                src={img.immagine}
                alt={img.alt}
                widths={[400, 560, 720, 1080]}
                sizes="(min-width: 1440px) 525px, (min-width: 1025px) 37vw, (min-width: 769px) 46vw, calc(100vw - 40px)"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>

      <div class="about__text">
        {
          chiSono.blocchi.map((b, i) => (
            <div class="about__block">
              <p class="num">/{String(i + 1).padStart(2, '0')}</p>
              <h2 class="h2 about__title">{b.titolo}</h2>
              {paragrafi(b.testo).map((p) => (
                <p class="text">{p}</p>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Eventi: un anno per riga, voci su più colonne (l'elenco completo è in Chi sono) -->
    <div class="about__events">
      <p class="num">/{String(chiSono.blocchi.length + 1).padStart(2, '0')}</p>
      <h2 class="h2 about__title">{chiSono.eventi.titolo}</h2>
      <div class="events">
        {
          chiSono.eventi.anni.map((a) => (
            <div class="events__year">
              <h3 class="events__anno">{a.anno}</h3>
              <ul role="list" class="events__voci">
                {a.voci.map((v) => (
                  <li>{v}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="about__links">
        <a class="btn-text" href="/chi-sono/">
          <span class="brush brush--on">Biografia completa</span>
        </a>
        <a class="btn-text" href="/chi-sono/#eventi">
          <span class="brush">Tutti gli eventi</span>
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * Tutte le sezioni stanno sul contenitore da 1300px e sulla griglia a 12 colonne
   * (.grid-12): titolo, opere, testi e piè di pagina partono dallo stesso bordo.
   */

  /* ---------- Hero ---------- */
  .hero {
    padding-top: 24px;
  }

  .hero__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 0.2rem + 10.4vw, 11.25rem); /* 180px su desktop */
    line-height: 0.833;
    text-transform: uppercase;
    color: #000;
    max-width: 11ch;
    hyphens: none;
  }

  .hero__works {
    display: grid;
    gap: 40px;
    margin-top: clamp(48px, 8vw, 160px);
  }

  .hero__work {
    position: relative;
    margin: 0;
  }

  .hero__label {
    margin-bottom: 12px;
  }

  .hero__media {
    display: block;
  }

  .hero__work--small .hero__media {
    aspect-ratio: 472 / 458;
  }

  .hero__work--big .hero__media {
    aspect-ratio: 1105 / 942;
  }

  /* da tablet: opera piccola su 4 colonne e grande su 8 (le proporzioni del tema), didascalie verticali */
  @media (min-width: 769px) {
    .hero__works {
      align-items: center;
      row-gap: 0;
    }

    .hero__work {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      gap: 19px;
    }

    .hero__work--small {
      grid-column: 1 / span 4;
    }

    .hero__work--big {
      grid-column: 5 / span 8;
    }

    .hero__label {
      margin: 0;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
    }
  }

  @media (min-width: 1025px) {
    .hero {
      padding-top: 230px; /* il titolo inizia sotto all'header "switch" */
    }
  }

  /* ---------- /01 Introduzione ---------- */
  .intro {
    display: grid;
    gap: 40px;
    align-items: center;
    margin-top: clamp(96px, 12vw, 220px);
  }

  .intro__title {
    margin-top: 12px;
    max-width: 22ch;
  }

  .intro__p {
    margin: 17px 0 0;
    max-width: 52ch;
  }

  .intro__link {
    margin-top: 30px;
  }

  /* mai più larga della foto originale (--w): questa è piccola, ingrandita sarebbe sfocata */
  .intro__figure {
    width: min(100%, var(--w, 650px));
    margin: 0;
  }

  .intro__figure :global(img) {
    width: 100%;
  }

  @media (min-width: 769px) {
    .intro {
      row-gap: 0;
    }

    .intro__text {
      grid-column: 1 / span 7;
    }

    .intro__figure {
      grid-column: 9 / span 4;
      justify-self: end;
    }
  }

  :global(.carousel) {
    margin-top: clamp(80px, 10vw, 180px);
  }

  :global(.marquee) {
    margin-top: clamp(80px, 9vw, 150px);
  }

  /* ---------- Chi sono / La mia arte ---------- */
  .about {
    margin-top: clamp(96px, 10vw, 190px);
  }

  .about__grid {
    display: grid;
    gap: 56px;
  }

  .about__images {
    display: grid;
    gap: 20px;
  }

  .about__image {
    margin: 0;
  }

  .about__image--0 {
    aspect-ratio: 629 / 500;
  }

  .about__image--1 {
    aspect-ratio: 709 / 600;
  }

  .about__text {
    display: grid;
    gap: clamp(48px, 5vw, 80px);
    align-content: start;
  }

  .about__block .num,
  .about__events > .num {
    margin: 0 0 12px;
  }

  .about__title {
    margin-bottom: 20px;
  }

  .about__block .text {
    max-width: 52ch;
    margin: 0 0 14px;
  }

  @media (min-width: 769px) {
    .about__grid {
      row-gap: 0;
      align-items: center;
    }

    .about__images {
      grid-column: 1 / span 6;
    }

    /* le due immagini sfalsate, come nel tema */
    .about__image--0 {
      width: 88%;
      margin-left: 12%;
    }

    .about__text {
      grid-column: 7 / span 6;
    }
  }

  @media (min-width: 1025px) {
    .about__images {
      grid-column: 1 / span 5;
    }
  }

  /* ---------- /03 Partecipazioni & eventi ---------- */
  .about__events {
    margin-top: clamp(80px, 9vw, 150px);
  }

  .events {
    margin-top: clamp(12px, 1.5vw, 24px);
  }

  .events__year {
    padding-top: 14px;
    border-top: 1px solid var(--c-text);
  }

  .events__year + .events__year {
    margin-top: clamp(24px, 2.6vw, 36px);
  }

  .events__anno {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--fs-h4);
    line-height: 1;
    color: var(--c-text);
  }

  .events__voci {
    margin-top: 14px;
    font-size: 1.0625rem; /* 17px */
    line-height: 1.35;
  }

  .events__voci li {
    margin-bottom: 6px;
    break-inside: avoid;
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: clamp(32px, 3.5vw, 48px) 0 0;
  }

  /* anno a sinistra, voci su più colonne: l'elenco resta compatto e si legge riga per riga */
  @media (min-width: 769px) {
    .events__year {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 10fr);
      column-gap: var(--grid-gap);
      padding-top: 18px;
    }

    .events__voci {
      margin-top: 3px;
      columns: 2;
      column-gap: var(--grid-gap);
    }
  }

  @media (min-width: 1025px) {
    .events__voci {
      columns: 3;
    }
  }
</style>
