---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import MasonryGrid from '~/components/MasonryGrid.astro';
import { site } from '~/config/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { altOpera, getOpereInEvidenza, getTemiConOpere, numero, urlOpera, urlTema } from '~/lib/opere';

const [inEvidenza, temi, chiSono] = await Promise.all([
  getOpereInEvidenza(6),
  getTemiConOpere(),
  getEntry('pagine', 'chi-sono'),
]);

const hero = inEvidenza[0];
const elencoTemi = new Intl.ListFormat('it', { type: 'conjunction' }).format(
  temi.map((t) => t.tema.data.titolo.toLowerCase()),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: 'it-IT',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author,
    url: site.url,
    jobTitle: 'Pittrice',
    sameAs: site.social.map((s) => s.url),
  },
];
---

<BaseLayout image={hero?.data.immagine} imageAlt={hero ? altOpera(hero) : undefined} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero container-wide" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="display hero__title">
        <span class="hero__line reveal">Tiziana</span>
        <span class="hero__line reveal" style="--delay:.1s">
          Guerra <em class="serif-italic hero__art">art</em>
        </span>
      </h1>
      <p class="hero__lead reveal" style="--delay:.25s">
        {site.tagline}{elencoTemi && <span class="hero__themes">: {elencoTemi}.</span>}
      </p>
      <a class="label hero__cta reveal" style="--delay:.35s" href="/pitture/">
        <span class="brush">Scopri le pitture</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    {
      hero && (
        <figure class="hero__figure">
          <a href={urlOpera(hero)} class="hero__media reveal-img" style="--delay:.15s">
            <Picture
              src={hero.data.immagine}
              alt={altOpera(hero)}
              widths={[600, 900, 1200, 1600]}
              sizes="(min-width: 1024px) 44vw, 100vw"
              formats={['avif', 'webp']}
              priority
            />
          </a>
          <figcaption class="hero__caption">
            <span class="num">{numero(0)}</span>
            <a class="label" href={urlOpera(hero)}>
              <span class="brush">{hero.data.titolo}</span>
            </a>
          </figcaption>
        </figure>
      )
    }

    <a class="hero__scroll label" href="#chi-sono" aria-label="Scorri alla presentazione">
      <span>Scorri</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <!-- CHI SONO (riassunto) -->
  {
    chiSono && (
      <section id="chi-sono" class="about container section" aria-labelledby="about-title">
        <p class="about__eyebrow">
          <span class="num">/</span>
          <span class="label">Chi sono</span>
        </p>
        <div class="about__body">
          <h2 id="about-title" class="display about__title">
            {chiSono.data.sottotitolo ?? chiSono.data.titolo}
          </h2>
          {chiSono.data.estratto && <p class="lead about__text">{chiSono.data.estratto}</p>}
          <a class="label about__link" href="/chi-sono/">
            <span class="brush">Leggi la biografia</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- OPERE IN EVIDENZA -->
  {
    inEvidenza.length > 0 && (
      <section class="featured container" aria-labelledby="featured-title">
        <header class="section-head">
          <h2 id="featured-title" class="display section-head__title">
            Opere <span class="serif-italic">in</span> evidenza
          </h2>
          <a class="label" href="/pitture/">
            <span class="brush">Tutte le pitture</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </header>
        <MasonryGrid opere={inEvidenza} eager={0} label="Opere in evidenza" headingLevel="h3" />
      </section>
    )
  }

  <!-- TEMI -->
  {
    temi.length > 0 && (
      <section class="themes container section" aria-labelledby="themes-title">
        <h2 id="themes-title" class="label themes__title">
          <span class="num">/</span> Temi
        </h2>
        <ul role="list" class="themes__list">
          {temi.map(({ tema, opere }, i) => (
            <li>
              <a class="themes__row" href={urlTema(tema.id)}>
                <span class="num themes__num">{numero(i)}</span>
                <span class="display themes__name">
                  <span class="roll">
                    <span class="roll__a">{tema.data.titolo}</span>
                    <span class="roll__b" aria-hidden="true">
                      {tema.data.titolo}
                    </span>
                  </span>
                </span>
                <span class="num themes__count">
                  {opere.length} {opere.length === 1 ? 'opera' : 'opere'}
                </span>
                {opere[0] && (
                  <span class="themes__preview" aria-hidden="true">
                    <Picture
                      src={opere[0].data.immagine}
                      alt=""
                      widths={[320, 480]}
                      sizes="240px"
                      formats={['avif', 'webp']}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    gap: clamp(36px, 6vw, 64px);
    padding-block: clamp(40px, 8vw, 120px) clamp(48px, 8vw, 110px);
  }

  .hero__title {
    font-size: clamp(2.8rem, 14.6vw, 8.5rem);
    line-height: 0.92;
  }

  .hero__line {
    display: block;
  }

  .hero__line + .hero__line {
    padding-left: 0.42em;
  }

  .hero__art {
    font-size: 1.04em;
    text-transform: none;
    font-stretch: 100%;
    letter-spacing: -0.01em;
    color: var(--c-muted);
  }

  .hero__lead {
    margin: clamp(22px, 3vw, 40px) 0 0;
    font-family: var(--f-serif);
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2.1rem);
    line-height: 1.35;
    color: var(--c-muted);
    max-width: 30ch;
  }

  .hero__cta {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(22px, 3vw, 40px);
    font-size: var(--fs-nav);
    font-weight: var(--display-weight);
    letter-spacing: 0;
  }

  .hero__figure {
    margin: 0;
  }

  .hero__media {
    display: block;
    background: var(--c-mat);
    box-shadow: 0 30px 60px -36px rgb(33 29 19 / 0.55);
  }

  .hero__media :global(img) {
    width: 100%;
    height: auto;
  }

  .hero__caption {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-top: 18px;
  }

  .hero__caption .num {
    font-size: 1.35rem;
  }

  .hero__caption .label {
    font-size: var(--fs-nav);
    font-weight: var(--display-weight);
    letter-spacing: 0;
  }

  .hero__scroll {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      min-height: calc(100svh - var(--header-h));
      padding-block: clamp(40px, 5vw, 80px);
    }

    .hero__title {
      font-size: clamp(4.6rem, 8.4vw, 10.5rem);
    }

    .hero__figure {
      justify-self: end;
      width: min(100%, 640px);
    }

    .hero__media :global(img) {
      max-height: 72svh;
      width: auto;
      margin-inline: auto;
    }

    .hero__scroll {
      position: absolute;
      left: 0;
      bottom: clamp(24px, 4vh, 48px);
      display: inline-flex;
      align-items: center;
      gap: 16px;
      color: var(--c-muted);
    }

    .hero__scroll i {
      display: block;
      width: 64px;
      height: 1px;
      background: currentColor;
      transform-origin: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero__scroll i {
        animation: scroll-line 2.4s var(--ease-in-out) infinite;
      }

      @keyframes scroll-line {
        0% {
          transform: scaleX(0);
        }
        50% {
          transform: scaleX(1);
          transform-origin: left;
        }
        50.1% {
          transform-origin: right;
        }
        100% {
          transform: scaleX(0);
          transform-origin: right;
        }
      }
    }
  }

  /* ---------- Chi sono ---------- */
  .about {
    display: grid;
    gap: 24px;
    border-top: 1px solid var(--c-line);
  }

  .about__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  .about__eyebrow .num {
    font-size: 1.5rem;
  }

  .about__title {
    font-size: var(--fs-h2);
    line-height: 1.02;
    max-width: 16ch;
  }

  .about__text {
    margin: clamp(24px, 3vw, 44px) 0 0;
    max-width: 40ch;
  }

  .about__link {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(24px, 3vw, 40px);
    font-size: var(--fs-nav);
    font-weight: var(--display-weight);
    letter-spacing: 0;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1fr 3fr;
    }
  }

  /* ---------- Opere in evidenza ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    margin-bottom: clamp(48px, 6vw, 96px);
  }

  .section-head__title {
    font-size: var(--fs-h2);
    line-height: 1;
  }

  .section-head__title .serif-italic {
    text-transform: lowercase;
    font-stretch: 100%;
    font-size: 1.08em;
    color: var(--c-muted);
  }

  .section-head .label {
    display: inline-flex;
    gap: 10px;
    font-size: var(--fs-nav);
    font-weight: var(--display-weight);
    letter-spacing: 0;
  }

  /* ---------- Temi ---------- */
  .themes__title {
    display: flex;
    gap: 10px;
    align-items: baseline;
    margin-bottom: clamp(24px, 3vw, 48px);
  }

  .themes__title .num {
    font-size: 1.5rem;
  }

  .themes__list {
    border-top: 1px solid var(--c-line);
  }

  .themes__row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(14px, 3vw, 48px);
    padding-block: clamp(18px, 2.6vw, 36px);
    border-bottom: 1px solid var(--c-line);
  }

  .themes__num {
    font-size: clamp(1.1rem, 0.9rem + 0.6vw, 1.5rem);
  }

  .themes__name {
    font-size: clamp(2rem, 0.9rem + 5vw, 6.25rem);
    line-height: 1.1;
  }

  .themes__count {
    font-size: clamp(1.05rem, 0.9rem + 0.4vw, 1.35rem);
  }

  .themes__preview {
    display: none;
  }

  @media (hover: hover) and (min-width: 900px) {
    .themes__preview {
      position: absolute;
      top: 50%;
      right: 18%;
      z-index: 2;
      display: block;
      width: 240px;
      opacity: 0;
      transform: translateY(-50%) rotate(-3deg) scale(0.9);
      transition:
        opacity var(--t-med) var(--ease-out),
        transform var(--t-slow) var(--ease-out);
      pointer-events: none;
      box-shadow: 0 24px 50px -20px rgb(33 29 19 / 0.5);
    }

    .themes__row:hover .themes__preview,
    .themes__row:focus-visible .themes__preview {
      opacity: 1;
      transform: translateY(-50%) rotate(-3deg) scale(1);
    }

    .themes__preview :global(img) {
      width: 100%;
      height: auto;
    }
  }
</style>
